# PHYSICA Environment Variables
# Do NOT place secrets in this file. Provide a copy named .env with actual values.

# LOCAL | AWS
PHYSICA_DATA_MODE=LOCAL

# Set to "production" in production environments
PHYSICA_ENV=development

# AWS Configuration (required if PHYSICA_DATA_MODE=AWS)
AWS_REGION=
AWS_IOT_ENDPOINT=
AWS_IOT_THING_NAME=
AWS_IOT_TOPIC_PREFIX=physica
BEDROCK_MODEL_ID=

# Allowed CORS origins (comma-separated). Set explicitly in production!
PHYSICA_ALLOWED_ORIGINS=http://localhost:3000
